opam-version: "2.0"
name: "piwana-tui"
version: "0.2.0"
synopsis: "A SQLite-backed terminal paper-review prototype"
license: "MIT"
authors: ["Kiwamu Okabe"]
depends: [
  "ocaml" {>= "4.13"}
  "dune" {>= "3.0"}
  "sqlite3"
  "yojson"
  "str"
  "uutf"
]
build: [ ["dune" "build" "-p" name "-j" jobs] ]
